# Copy to /etc/rs3mini-bridge.env on the bridge host (chmod 600).
#
# Gimbal discovery: always BLE scan, then match advertised name.
# Suffix is on the gimbal LCD and DJI app (advertises as DJI RS3 MINI-<suffix>).
GIMBAL_NAME_RE=YOURSUFFIX

PORT=8787
RECONNECT_MS=5000
STARTUP_GUARD_MS=5000
MOVE_HOLD_MS=0
# Page 3: release = POST /move/stop. Set >0 only for orphan silence lease (lab).
HOLD_PROMOTE_MS=250
# Release before this = fixed nudge; after this = hold stop.
NUDGE_MS=180
# Minimum quick-tap deflection duration from finger-down.
RELEASE_NEUTRAL_FRAMES=3
# Short, interruptible neutral sequence after release.
MOVE_STICK_SCALE=0.05
# Stick throw fraction — lower = finer tap/hold speed
MAX_MOVE_MS=15000
# Absolute auto-stop if /move/stop never arrives
LOG_LEVEL=info

# Wi-Fi link poll — logs SSID/signal to journal on change; exposed on GET /state
# WIFI_IFACE=wlan0
# WIFI_POLL_MS=15000
# Boot wait before BLE (Pi Zero shared radio) — see scripts/wait-wifi.sh
# WIFI_WAIT_TIMEOUT_SEC=120
# When using Alfa USB STA, set WIFI_IFACE to that iface (e.g. wlan1)

# Pi/Linux BLE timing (defaults suit RS 3 Mini on Pi Zero)
# CONNECT_TIMEOUT_MS=45000
# CONNECT_TOTAL_MS=160000
# CONNECT_STALE_MS=160000
# CONNECT_DELAY_MS=500
# GATT_DISCOVER_MS=15000
# GATT_DISCOVER_RETRIES=2
# PAIRING_WRITE_NO_RESPONSE=1   # force no-response write (default on Linux)
# PAIRING_WRITE_MS=5000
# PAIRING_DELAY_MS=300

# Optional LAN auth (Companion generic-http header X-Bridge-Token)
# BRIDGE_TOKEN=
