# Site / kit config — copy to site.env and fill in.
# site.env is gitignored. On install it is merged into /etc/rs3mini-bridge.env
# (runtime keys only). Deploy scripts also read PI_* / COMPANION_* from it.
#
#   cp site.env.example site.env
#   # edit site.env
#   bash scripts/deploy.sh
#   # password SSH: keep PI_PASSWORD in ../.local/pi-bridge.env (not in site.env —
#   # site.env is rsynced onto the Pi)

# ── Deploy (laptop → bridge host) ───────────────────────────────────────────
PI_HOST=192.168.0.50
PI_USER=pi
INSTALL_ROOT=/opt/rs3mini-bridge

# ── Companion import (optional) ─────────────────────────────────────────────
COMPANION_HOST=192.168.0.51
COMPANION_PORT=8000

# ── Bridge runtime (merged into /etc/rs3mini-bridge.env on install) ─────────
GIMBAL_NAME_RE=YOURSUFFIX
PORT=8787
WIFI_IFACE=wlan0
# WIFI_POLL_MS=15000
# WIFI_WAIT_TIMEOUT_SEC=120
# BRIDGE_TOKEN=

# Operator notes only (not applied to systemd):
# WIFI_SSID=YOUR-SSID
# BRIDGE_LAN_IP=192.168.0.50
